# Optional: copy to .env. Parity loads this local file automatically.
# Free local chat is the default. No key, credits, or account needed.
PARITY_CHAT_PROVIDER=local
PARITY_PROFILE=postgresql
PARITY_DB_PORT=5432
# PARITY_DB_PASSWORD is generated on first database setup; retain it for this Docker volume.
PARITY_EMBEDDER=minilm
PARITY_PORT=8000
PARITY_LOCAL_CHAT_PORT=8091
# Models are cached by setup.bat; normal runs load locally.
PARITY_OFFLINE=1
# PARITY_DATA_DIR=C:/path/to/separate/data
# PARITY_CACHE_DIR=C:/path/to/separate/cache
# Relative paths are resolved from the repository directory.
# DATABASE_URL=postgresql+psycopg://parity:your-local-password@127.0.0.1:5432/parity
# Use PARITY_PROFILE=sqlite or --profile sqlite to select compatibility mode explicitly.
# Optional PAID OpenAI mode; leave these commented for free operation.
# PARITY_CHAT_PROVIDER=openai
# OPENAI_API_KEY=configure-locally-only
# PARITY_CHAT_MODEL=gpt-5.4-mini-2026-03-17
# Access tokens are generated per launch. Do not share your .env file.
